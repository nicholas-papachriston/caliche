{
  "name": "@caliche/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Pure wire contracts and parsers for Caliche (no native binding)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholas-papachriston/caliche"
  },
  "homepage": "https://github.com/nicholas-papachriston/caliche",
  "author": "Nicholas Papachriston <nicholas@papachriston.com>",
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.cjs",
  "module": "./index.js",
