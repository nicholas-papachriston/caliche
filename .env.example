# Caliche Environment Configuration (canonical template)
# Copy this file to .env and fill in your credentials. Never commit .env.
# `caliche` and `caliche_server` read it only when you pass `--env-file .env`.

# =============================================================================
# LLM Provider Credentials
# =============================================================================

# OpenAI (required for OpenAI provider)
OPENAI_API_KEY=sk-...
# Model ID when using OpenAI; used as default if DEFAULT_MODEL is unset
OPENAI_MODEL=gpt-5.4
# Optional: expose the generate_image tool with OpenAI image generation
# CALICHE_IMAGE_PROVIDER=openai
# CALICHE_IMAGE_MODEL=gpt-image-1

# Anthropic (required for Claude)
ANTHROPIC_API_KEY=<anthropic-api-key>
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Skip OS keyring prompts in CI and agent wrappers (env vars still apply)
# CALICHE_NO_KEYRING=1

# AWS (required for Bedrock). Prefer AWS_PROFILE from IAM Identity Center.
# Do not copy access keys into secretspec.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# OpenRouter (proxy to many models with one key)
OPENROUTER_API_KEY=...

# Perplexity (web-grounded answers)
PERPLEXITY_API_KEY=...

# web_fetch is on by default. web_search stays opt-in. Neither tool runs a browser.
# Fetch order: TinyFish (TINYFISH_API_KEY) -> Firecrawl (FIRECRAWL_API_KEY) -> plain HTTP.
# With no fetch keys, web_fetch uses plain HTTP only and does not POST the URL to Firecrawl.
# Search order (when web_search is enabled): Tavily, then Exa, then TinyFish, then Firecrawl.
# TinyFish provides search and URL fetch with an API key from agent.tinyfish.ai.
# Firecrawl search works keyless. Firecrawl fetch runs only when FIRECRAWL_API_KEY is set.
# TAVILY_API_KEY=...
# EXA_API_KEY=...
# TINYFISH_API_KEY=...
# TINYFISH_SEARCH_API_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_API_URL=https://api.fetch.tinyfish.ai
# FIRECRAWL_API_KEY=...
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Google Gemini
GOOGLE_API_KEY=...
# Optional Google image generation model for generate_image
# GOOGLE_IMAGE_MODEL=models/gemini-2.5-flash-image

# Generated artifacts default to .caliche/artifacts
# CALICHE_ARTIFACT_DIR=.caliche/artifacts

# Cohere
COHERE_API_KEY=...

# Azure OpenAI (use your resource name and deployment ID from Azure Portal)
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_RESOURCE_NAME=your-resource
AZURE_OPENAI_DEPLOYMENT_ID=your-deployment

# LM Studio (local server; base URL must end with /v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Ollama (local; default base URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# -----------------------------------------------------------------------------
# In-process local inference
# Prefer Ollama/LM Studio above for day-to-day local chat.
# Features: local-inference (Candle+ORT), local-inference-candle / -ort alone,
# local-inference-llamacpp for GGUF (opt-in native build; not in the umbrella).
# Use doctor or /local-model fit to see which catalog models fit host RAM.
# -----------------------------------------------------------------------------
# CALICHE_LOCAL_INFERENCE_BACKEND=candle          # candle | ort | mlx | gguf | llamacpp
# CALICHE_LOCAL_INFERENCE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# CALICHE_LOCAL_INFERENCE_DOWNLOAD_REPO=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# CALICHE_LOCAL_INFERENCE_DOWNLOAD_REVISION=main
# CALICHE_LOCAL_INFERENCE_MODEL_DIR=./models/tinyllama-1.1b-candle
# CALICHE_LOCAL_INFERENCE_MODELS_DIR=./models
# CALICHE_LOCAL_INFERENCE_HF_CACHE_DIR=           # defaults to HF_HOME or ~/.cache/huggingface
# CALICHE_LOCAL_INFERENCE_BOOTSTRAP=1            # force bootstrap even for local sources
# CALICHE_LOCAL_INFERENCE_CONTINUE_ON_ERROR=1    # soft-fail bootstrap (default is hard-fail)
# CALICHE_LOCAL_INFERENCE_DISABLE_CURL_FALLBACK=1
# CALICHE_LOCAL_INFERENCE_MAX_DOWNLOAD_BYTES=21474836480  # 20 GiB default; 0 = unlimited
# CALICHE_LOCAL_INFERENCE_DISK_RESERVE_BYTES=536870912    # keep 512 MiB free after downloads
# CALICHE_LOCAL_INFERENCE_RESERVE_RAM_BYTES=1610612736    # caliche maps this onto Dripstone FitOptions
# CALICHE_LOCAL_INFERENCE_MAX_TOKENS=256
# CALICHE_LOCAL_INFERENCE_DEVICE=auto             # auto | cpu | metal | cuda | mlx (cfg selection; not a RAM probe)
# HF_TOKEN=                                 # or HUGGING_FACE_HUB_TOKEN for gated repos

# =============================================================================
# Vector Database Backends
# =============================================================================
# VECTOR_BACKEND chooses where embeddings are stored for RAG and vector memory.
# memory = in-process, no persistence (default, good for dev).
# redis, postgres, qdrant, qdrant-grpc, pinecone, chroma, weaviate, milvus = remote stores.
# s3 = S3 object storage; coldforge = S3 with SPFresh index (large scale).
# dynamodb = DynamoDB native vector SearchVectors (requires vector-store-dynamodb).
# tiered = chain of backends (e.g. cold S3 + hot Redis); configure via API only.
VECTOR_BACKEND=memory

# -----------------------------------------------------------------------------
# Docker Compose stack (`docker-compose.yml`) defaults for local integration tests
# -----------------------------------------------------------------------------
# Passwords below are local-dev only. Override STACK_* vars or URLs for your environment.
# Set EMBEDDING_*_API_KEY= (empty) to disable API keys when talking to an unsecured server.
# STACK_REDIS_PASSWORD=caliche_dev_redis
# STACK_POSTGRES_PASSWORD=caliche_dev_pg
# STACK_QDRANT_API_KEY=caliche_dev_qdrant
# STACK_WEAVIATE_API_KEY=caliche_dev_weaviate
# STACK_GRAFANA_ADMIN_PASSWORD=caliche_dev_grafana
# STACK_PROMETHEUS_PASSWORD=caliche_dev_prom
# Prometheus UI basic auth user is `stack` (see deploy/prometheus-web.yml).

# Redis (connection URL; used when VECTOR_BACKEND=redis)
REDIS_URL=redis://:caliche_dev_redis@localhost:6379

# Valkey (compose maps host 6380; same password as Redis by default)
# VALKEY_URL=redis://:caliche_dev_redis@localhost:6380

# PostgreSQL with pgvector (used when VECTOR_BACKEND=postgres)
POSTGRES_URL=postgresql://postgres:caliche_dev_pg@localhost:5433/embeddings

# Qdrant: HTTP and gRPC (gRPC is faster for large datasets)
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334
EMBEDDING_QDRANT_API_KEY=caliche_dev_qdrant

# Pinecone (index host from Pinecone console, e.g. xxx.svc.pinecone.io)
PINECONE_API_KEY=...
PINECONE_INDEX_HOST=...

# Chroma (local or remote Chroma server)
CHROMA_URL=http://localhost:8000

# Weaviate (required when anonymous access is disabled in compose)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=caliche_dev_weaviate
EMBEDDING_WEAVIATE_API_KEY=caliche_dev_weaviate

# Milvus
MILVUS_URL=http://localhost:19530

# S3 / ColdForge: bucket and key prefix for vector objects
# S3_BUCKET is commented out so tests do not treat a placeholder as a live bucket.
# Set DRIPSTONE_INT_S3_BUCKET (and AWS credentials) only for an explicit S3 integration run.
# S3_BUCKET=my-bucket
S3_PREFIX=embeddings/

# DynamoDB native vectors (VECTOR_BACKEND=dynamodb; feature vector-store-dynamodb)
# DRIPSTONE_DYNAMODB_TABLE=my-vectors
# DRIPSTONE_DYNAMODB_INDEX=embeddings
# DRIPSTONE_DYNAMODB_ENDPOINT=
# DRIPSTONE_DYNAMODB_ENSURE=0
# VECTOR_BACKEND_DIMENSION=1536
# CALICHE_DEFERRED_ANN_INDEX=true wraps workspace disk SQLite stores and default
# Indexed backend configs with deferred HNSW indexing (commit now, index later).
# CALICHE_DEFERRED_ANN_INDEX=false
# CALICHE_DEFERRED_FLUSH_THRESHOLD=256
# CALICHE_DEFERRED_SEARCH_FLUSH_THRESHOLD=512
# CALICHE_DEFERRED_MAX_TAIL_SCAN=256

# =============================================================================
# API Server Configuration (when running caliche --server)
# =============================================================================
# Public / internet-reachable hosts MUST set:
#   CALICHE_ENV=production
#   JWT_ENABLED=true plus a key or JWKS
#   JWT_AUDIENCE and JWT_ISSUER (operator-supplied; never a built-in default)
#   CALICHE_REQUIRE_AUTH=true
# Leave CALICHE_ALLOW_INSECURE_PRODUCTION unset.
# The HTTP API is not authenticated by default.
# Checklist: docs/ops/production-auth-checklist.md

# Optional directory for server.lock, servers/, config.toml, mcp.json, and plugins.db.
# Empty is ignored. When unset, the platform config and data directories are used.
# CLI logs, endpoints.json, gateway-cluster.db, the session DB, and CLI tasks.db
# stay on their own roots (data dir, or ~/.caliche via HOME).
# CALICHE_CONFIG_DIR=

# Documented bind host. caliche --server listens on --bind (default 127.0.0.1)
# and does not apply API_HOST. 0.0.0.0 and :: are every-interface values: unsafe
# on a public host without the production matrix above. Startup warns and still
# starts when this value or BIND_ADDRESS is 0.0.0.0 or :: while the production
# profile and CALICHE_REQUIRE_AUTH are off. An explicit --bind 0.0.0.0 warns
# and still starts. The loopback default is a listen address only.
# Uncommenting API_HOST=0.0.0.0 exposes the server on every interface.
# API_HOST=0.0.0.0
# Listen port for the standalone caliche_server binary. The CLI uses --port.
PORT=3000

# Provider and model used when no flag or saved setting selects one
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4

# Provider routing (static, weighted, cost). When weighted/cost, set the corresponding vars.
# CALICHE_ROUTER_STRATEGY=static
# CALICHE_ROUTER_WEIGHTS=openai:gpt-4o-mini:70,anthropic:claude-3-haiku:30
# CALICHE_ROUTER_COST_TABLE={"openai:gpt-4o-mini":{"input_per_1k":0.15,"output_per_1k":0.6}}

# Per-tenant spend budgets (optional). Requires JWT tenant_id or equivalent.
# CALICHE_SPEND_BUDGET_PER_TENANT_TOKENS=1000000
# CALICHE_SPEND_BUDGET_PER_TENANT_COST=10000

# Optional JWT auth: enable before exposing the API outside local development.
# Local open-API defaults stay false. A public host must turn both on (see checklist).
JWT_ENABLED=false
# JWT_PUBLIC_KEY, JWT_PUBLIC_KEY_PATH, or JWT_JWKS_URL is required when JWT_ENABLED=true.
# JWT_AUDIENCE and JWT_ISSUER are required when JWT_ENABLED=true.
# Empty audience or issuer fails startup. There is no built-in audience or issuer.
# JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_PATH=
# JWT_JWKS_URL=
# JWT_AUDIENCE=
# JWT_ISSUER=
# Require JWT on most /api/* routes (requires JWT_ENABLED=true). Startup fails if misconfigured.
CALICHE_REQUIRE_AUTH=false
# /api/orchestration/* and /api/workflows/* refuse unauthenticated requests by default.
# Set this to true for a local run only; it is ignored when CALICHE_ENV=production.
CALICHE_ALLOW_UNAUTH_ORCHESTRATION=false
# production profile: JWT + REQUIRE_AUTH are mandatory unless CALICHE_ALLOW_INSECURE_PRODUCTION=1
# CALICHE_ENV=production
# CALICHE_ALLOW_INSECURE_PRODUCTION=false
# Keep chat stream public even when REQUIRE_AUTH is set (local/dev only)
# CALICHE_PUBLIC_CHAT=false
# Honor X-Forwarded-For only from these proxy CIDRs when CALICHE_TRUSTED_PROXY=true
# CALICHE_TRUSTED_PROXY=false
# CALICHE_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16

# =============================================================================
# Security Hardening (plugins, MCP, webhooks, metrics)
# =============================================================================
# Comma-separated hostnames allowed for plugin http steps (always blocks private/metadata hosts).
# Required when CALICHE_ENV=production (use * to allow any public host).
# PLUGIN_HTTP_ALLOWLIST=api.example.com,cdn.example.com
# Gateway egress allowlist (tool HTTP, MCP HTTP, model providers). Production is default-deny.
# CALICHE_EGRESS_POLICY_PATH=./gateway-egress.toml
# CALICHE_EGRESS_MODE=default_deny
# CALICHE_EGRESS_ALLOW=api.openai.com,api.anthropic.com
# CALICHE_EGRESS_TOOLS=api.github.com
# CALICHE_EGRESS_MCP=localhost,mcp.example.com
# CALICHE_EGRESS_PROVIDERS=api.openai.com
# CALICHE_EGRESS_INCLUDE_DEFAULT_PROVIDERS=true
# CALICHE_SUSPEND_DIR=~/.caliche/suspended
# CALICHE_OPERATION_DISPATCH=1
# Abort agent build when plugin store load fails (default: warn)
# CALICHE_PLUGIN_LOAD_POLICY=fail
# Comma-separated executables allowed for API stdio MCP registration (required for stdio MCP via API)
# CALICHE_MCP_COMMAND_ALLOWLIST=npx,uvx
# Require webhook signature secrets for enabled gateway adapters
# CALICHE_WEBHOOK_REQUIRE_VERIFICATION=true
# Canonical public origin for webhook signature URLs (do not trust X-Forwarded-* by default)
# CALICHE_PUBLIC_BASE_URL=https://hooks.example.com
# CALICHE_TRUST_FORWARDED_HEADERS=true
# Bearer token for /metrics when CALICHE_REQUIRE_AUTH=true
# CALICHE_METRICS_TOKEN=...

# =============================================================================
# Gateway Channels (Webhook/Auth)
# =============================================================================
# Telegram adapter + optional webhook token verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Discord adapter + optional Ed25519 request verification
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Twilio adapter + optional signature validation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=false

# Slack adapter + optional request signing verification
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams outgoing webhook destination (used for delivery)
TEAMS_WEBHOOK_URL=
# Optional bearer token for Teams webhook ingress verification
# TEAMS_WEBHOOK_SECRET=...

# =============================================================================
# File Browser (UI feature; requires API server)
# =============================================================================
# When true, UI can list/read files under CALICHE_WORKSPACE for context.
CALICHE_FILE_BROWSING=false

# Root directory for file browsing; requests outside this path are rejected
CALICHE_WORKSPACE=/path/to/your/project

# =============================================================================
# Keychain (macOS CLI)
# =============================================================================
# On macOS, credentials use the data-protection keychain (Touch ID / passcode) by default.
# Set to false to use the regular keychain instead.
# CALICHE_KEYCHAIN_USE_TOUCH_ID=false

# =============================================================================
# Bedrock Embeddings
# =============================================================================
# Set to enable Bedrock embeddings for the RAG tool (e.g. amazon.titan-embed-text-v1)
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# =============================================================================
# Dripstone integration benchmarks (see dripstone/README.md)
# =============================================================================
# Leave DRIPSTONE_INT_PARQUET_DIR unset to use ann-benchmarks HDF5 (DRIPSTONE_INT_DATASET_URL).
# For Hugging Face Parquet (e.g. CohereLabs/wikipedia-2023-11-embed-multilingual-v3), download
# shards locally and set:
# DRIPSTONE_INT_PARQUET_DIR=/path/to/simple
# DRIPSTONE_INT_PARQUET_RECURSIVE=1
# DRIPSTONE_INT_PARQUET_EMB_COLUMN=emb
# DRIPSTONE_INT_SEARCH_METRIC=dot
# DRIPSTONE_INT_DATASET_NAME=wiki-simple-cohere-v3
# HDF5 only: default subset_exact recomputes exact neighbors on loaded train rows; use hdf5 for legacy file neighbors.
# DRIPSTONE_INT_GROUND_TRUTH_SOURCE=subset_exact

# =============================================================================
# Logging (tracing / RUST_LOG)
# =============================================================================
# Levels: trace, debug, info, warn, error. Module filter: caliche=debug,reqwest=warn
RUST_LOG=info
# Hotpath spans (grep/edit/search) on `caliche::perf`. Default: on in debug
# builds and with --debug; off in release. Override with 0/1 or CLI --no-perf.
# CALICHE_PERF=0

# =============================================================================
# Jev-based Compaction Pre-Filter (Experimental)
# =============================================================================
# TypeSafe System One (Jev) API key for intelligent tool pruning before summarization
# TYPESAFE_API_KEY=
# CALICHE_JEV_API_KEY=
# CALICHE_JEV_MODEL=jev-latest
# CALICHE_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# CALICHE_JEV_KEEP_THRESHOLD=0.5
# CALICHE_JEV_PRESERVE_RECENT=6
# CALICHE_JEV_MAX_STATE_TOKENS=25000
# CALICHE_JEV_MAX_REQUEST_TOKENS=30000
# CALICHE_JEV_TRUNCATE_HEAD_CHARS=300
# CALICHE_JEV_MIN_REDUCTION_RATIO=0.0


