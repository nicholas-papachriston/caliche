# Copy to `.env` for local runs. Leave secrets empty. Do not commit `.env`.
# Dripstone reads process environment variables; it does not load this file itself.

# AWS (S3, ColdForge, DynamoDB, S3 Vectors). Prefer a local profile over long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Model artifact cache and download budgets.
DRIPSTONE_CACHE_DIR=
DRIPSTONE_DISK_RESERVE_BYTES=
DRIPSTONE_RESERVE_RAM_BYTES=

# Optional local services. Defaults for the example stack live in
# docker-compose.example.yml. Leave these empty unless you are overriding that file.
REDIS_URL=
POSTGRES_URL=
EMBEDDING_PG_URL=
AGE_URL=
NEO4J_URI=
NEO4J_PASSWORD=

# Optional API tokens. Empty means "do not send a credential header".
EMBEDDING_QDRANT_API_KEY=
EMBEDDING_WEAVIATE_API_KEY=
EMBEDDING_CHROMA_API_KEY=
STACK_QDRANT_API_KEY=
STACK_WEAVIATE_API_KEY=
STACK_CHROMA_API_KEY=
STACK_REDIS_PASSWORD=
STACK_POSTGRES_PASSWORD=

# Optional MinIO / generic S3 for ColdForge tests.
DRIPSTONE_MINIO_ENDPOINT=
DRIPSTONE_MINIO_ACCESS_KEY=
DRIPSTONE_MINIO_SECRET_KEY=
OBJECT_STORE_ENDPOINT=

# Optional DynamoDB native vector tests.
DRIPSTONE_DYNAMODB_TABLE=
DRIPSTONE_DYNAMODB_INDEX=
DRIPSTONE_DYNAMODB_REGION=
DRIPSTONE_DYNAMODB_ENDPOINT=
DRIPSTONE_DYNAMODB_ENSURE=
DRIPSTONE_DYNAMODB_FORCE=
