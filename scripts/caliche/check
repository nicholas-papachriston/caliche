#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if caliche_want_help "${1:-}"; then
  cat <<'EOF'
Usage: ./caliche check

  Type-check Rust, JavaScript, and Python (no build)
EOF
  exit 0
fi

caliche_run rust check
caliche_run js typecheck
caliche_run py typecheck
