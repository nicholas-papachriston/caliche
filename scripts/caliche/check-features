#!/usr/bin/env bash
#
# check-features - Run cargo check against all feature flag combinations
#
# Ordered to maximize artifact reuse:
#   1. dripstone (leaf dependency, no caliche dep)
#   2. caliche core crate (builds incrementally from small to large feature sets)
#   3. caliche_server (depends on caliche)
#   4. caliche_cli (depends on caliche + caliche_server)
#   5. caliche_py (depends on caliche with full)
#   6. caliche_js (depends on caliche with full)
#   7. caliche_web (independent, Dioxus-based)
#
# Within each crate, features are ordered so that each step adds incrementally
# on top of previously compiled artifacts rather than invalidating them.

set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

if caliche_want_help "${1:-}"; then
  cat <<'EOF'
Usage: ./caliche check-features

  cargo check the workspace feature matrix
  Set STOP_ON_FAIL=1 to abort on first failure
EOF
  exit 0
fi


# ---- Configuration ----
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
DIM='\033[2m'
NC='\033[0m'

PASS_COUNT=0
FAIL_COUNT=0
TOTAL_COUNT=0
FAILED_CHECKS=()
START_TIME=$(date +%s)

# ---- Helpers ----
run_check() {
    local label="$1"
    shift
    TOTAL_COUNT=$((TOTAL_COUNT + 1))
    local step_start
    step_start=$(date +%s)

    printf "${BLUE}[%3d] %-70s${NC}" "$TOTAL_COUNT" "$label"

    if "$@" 2>&1 | tail -5 > /tmp/check_all_features_last.log; then
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        printf "${GREEN} OK${NC} ${DIM}(%ds)${NC}\n" "$elapsed"
        PASS_COUNT=$((PASS_COUNT + 1))
    else
        local step_end
        step_end=$(date +%s)
        local elapsed=$((step_end - step_start))
        printf "${RED} FAIL${NC} ${DIM}(%ds)${NC}\n" "$elapsed"
        FAIL_COUNT=$((FAIL_COUNT + 1))
        FAILED_CHECKS+=("$label")
        if [ "${STOP_ON_FAIL:-0}" = "1" ]; then
            echo ""
            echo "${RED}Stopping on first failure. Last output:${NC}"
            cat /tmp/check_all_features_last.log
            exit 1
        fi
    fi
}

print_header() {
    echo ""
    echo "${YELLOW}========================================================================${NC}"
    echo "${YELLOW}  $1${NC}"
    echo "${YELLOW}========================================================================${NC}"
    echo ""
}

# ---- Main ----
echo ""
echo "${BLUE}Caliche - Comprehensive Feature Check${NC}"
echo "${DIM}Checking all feature flag combinations across all workspace crates${NC}"
echo "${DIM}Set STOP_ON_FAIL=1 to abort on first failure${NC}"
echo ""

