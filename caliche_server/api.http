###############################################################################
# DATA MANIPULATION TOOL
###############################################################################

### Parse JSON String
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to parse this JSON string: '{\"name\": \"John\", \"age\": 30, \"city\": \"New York\"}'",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

### Parse CSV to JSON
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to parse this CSV: 'Name,Age,City\\nJohn,30,New York\\nJane,25,Los Angeles\\nBob,35,Chicago'",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

### Convert JSON to CSV
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to convert this JSON array to CSV: [{\"name\": \"John\", \"age\": 30}, {\"name\": \"Jane\", \"age\": 25}]",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

### Parse XML to JSON
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to parse this XML: '<root><user><name>John</name><age>30</age></user></root>'",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

### Extract JSON Path
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to extract the value at path '$.users[0].name' from this JSON: {\"users\": [{\"name\": \"John\", \"age\": 30}, {\"name\": \"Jane\", \"age\": 25}]}",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

### Merge JSON Objects
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the data_manipulation tool to merge these JSON objects: {\"a\": 1, \"b\": 2} and {\"b\": 3, \"c\": 4}",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["data_manipulation"]
}

###############################################################################
# CODE EXECUTION TOOL
###############################################################################
#
# The execute_python tool runs Python code in a sandboxed environment:
#
# FEATURES:
# - Python 3 standard library only (no pip packages)
# - 30-second execution timeout
# - 1MB output size limit
# - Isolated subprocess execution
#
###############################################################################

### Simple Calculation
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use Python to calculate the factorial of 10",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["execute_python"]
}

