###############################################################################
# REASONING PATTERNS (requires feature: reasoning-patterns)
###############################################################################

### List Available Reasoning Patterns
GET {{baseUrl}}/api/reasoning/patterns

### ReAct Pattern - Reasoning and Acting
POST {{baseUrl}}/api/reasoning/react
Content-Type: application/json

{
  "question": "What is the current temperature in San Francisco and how does it compare to New York?",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "max_iterations": 5,
  "tools": ["perplexity_search", "calculator"]
}

### Plan-Execute Pattern
POST {{baseUrl}}/api/reasoning/plan-execute
Content-Type: application/json

{
  "goal": "Research the top 3 programming languages in 2024 and compare their popularity",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["perplexity_search"]
}

### Self-Ask Pattern
POST {{baseUrl}}/api/reasoning/self-ask
Content-Type: application/json

{
  "question": "Who is the CEO of the company that makes iPhone?",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "max_depth": 3,
  "tools": ["perplexity_search"]
}

### Reflexion Pattern - Self-Reflection
POST {{baseUrl}}/api/reasoning/reflexion
Content-Type: application/json

{
  "task": "Write a function to calculate fibonacci numbers and optimize it",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "max_iterations": 3
}

### Tree of Thoughts Pattern
POST {{baseUrl}}/api/reasoning/tree-of-thoughts
Content-Type: application/json

{
  "problem": "Design a scalable microservices architecture for an e-commerce platform",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "num_thoughts": 3,
  "depth": 2
}

###############################################################################
# CHAIN WORKFLOWS (requires feature: chains)
###############################################################################

### LLM Chain - Single Step
POST {{baseUrl}}/api/chains/llm
Content-Type: application/json

{
  "prompt_template": "Summarize this text in one sentence: {text}",
  "input": {
    "text": "Artificial Intelligence is transforming industries by automating complex tasks, improving decision-making through data analysis, and enabling new capabilities like natural language understanding and computer vision."
  },
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Sequential Chain - Multiple Steps
POST {{baseUrl}}/api/chains/sequential
Content-Type: application/json

{
  "chains": [
    {
      "name": "summarize",
      "prompt_template": "Summarize this text: {input}",
      "output_key": "summary"
    },
    {
      "name": "translate",
      "prompt_template": "Translate to Spanish: {summary}",
      "output_key": "translation"
    }
  ],
  "input": {
    "input": "Machine learning is a subset of artificial intelligence that enables systems to learn and improve from experience without being explicitly programmed."
  },
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Map-Reduce Chain - Process Multiple Items
POST {{baseUrl}}/api/chains/map-reduce
Content-Type: application/json

{
  "map_template": "Summarize this review: {review}",
  "reduce_template": "Combine these summaries into one overall sentiment: {summaries}",
  "input": {
    "reviews": [
      "This product is amazing! Best purchase ever.",
      "Not worth the money. Very disappointed.",
      "Good quality but shipping was slow."
    ]
  },
  "provider": "{{provider}}"
}

###############################################################################
# RETRIEVAL CHAINS (requires feature: retrieval-chains)
###############################################################################
#
# Note: Requires OPENAI_API_KEY or BEDROCK_EMBEDDINGS_ENABLED for embeddings.
#
###############################################################################

### Retrieval Chain - RAG-based QA
POST {{baseUrl}}/api/chains/retrieval
Content-Type: application/json

{
  "query": "What is Rust's ownership model?",
  "documents": [
    "Rust's ownership system ensures memory safety without garbage collection. Each value has a single owner.",
    "Python uses reference counting and garbage collection for memory management.",
    "Go provides automatic memory management through garbage collection."
  ],
  "top_k": 2,
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Hybrid Search Chain - Combine Vector and Keyword Search
POST {{baseUrl}}/api/chains/hybrid-search
Content-Type: application/json

{
  "query": "memory safety features",
  "search_mode": "hybrid",
  "fusion_mode": "weighted",
  "dense_weight": 0.6,
  "sparse_weight": 0.4,
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Hybrid Search Chain - Dense + Full-Text with RRF
POST {{baseUrl}}/api/chains/hybrid-search
Content-Type: application/json

{
  "query": "memory safety features",
  "search_mode": "hybrid_full_text",
  "fusion_mode": "rrf",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Document Map-Reduce Chain - Process Large Documents
POST {{baseUrl}}/api/chains/document-map-reduce
Content-Type: application/json

{
  "document": "This is a very long document about machine learning. Machine learning is a method of data analysis that automates analytical model building. It is a branch of artificial intelligence based on the idea that systems can learn from data, identify patterns and make decisions with minimal human intervention. Deep learning is a subset of machine learning.",
  "task": "Summarize the main points about machine learning",
  "chunk_size": 100,
  "chunk_overlap": 20,
  "provider": "{{provider}}",
  "model": "{{model}}"
}

###############################################################################
# DOCUMENT PROCESSING (requires features: document-loaders, tools-rag)
###############################################################################

### Split Documents into Chunks
POST {{baseUrl}}/api/documents/split
Content-Type: application/json

{
  "documents": [
    {
      "content": "This is a long document that needs to be split into smaller chunks for processing. Each chunk should be manageable for the LLM.",
      "metadata": {
        "source": "test.txt"
      }
    }
  ],
  "chunk_size": 50,
  "chunk_overlap": 10
}

### Load Documents from Files
POST {{baseUrl}}/api/documents/load
Content-Type: application/json

{
  "paths": [
    "README.md",
    "Cargo.toml"
  ],
  "loader_type": "text"
}

### Index Documents for Semantic Search
POST {{baseUrl}}/api/documents/index
Content-Type: application/json

{
  "collection_name": "tech_docs",
  "documents": [
    {
      "content": "Rust is a systems programming language focused on safety and performance.",
      "metadata": {
        "source": "rust_intro.txt",
        "topic": "programming"
      }
    },
    {
      "content": "Python is a high-level programming language known for simplicity.",
      "metadata": {
        "source": "python_intro.txt",
        "topic": "programming"
      }
    }
  ]
}

### List Document Collections
GET {{baseUrl}}/api/documents/collections

### Search Documents by Semantic Similarity
POST {{baseUrl}}/api/documents/search
Content-Type: application/json

{
  "collection_name": "tech_docs",
  "query": "memory safety in programming languages",
  "top_k": 5,
  "search_mode": "dense",
  "min_similarity": 0.7
}

### Search Documents by Full-Text Retrieval
POST {{baseUrl}}/api/documents/search
Content-Type: application/json

{
  "collection_name": "tech_docs",
  "query": "ownership borrowing compile time",
  "top_k": 5,
  "search_mode": "full_text"
}

### Search Documents with Dense + Full-Text Hybrid Retrieval
POST {{baseUrl}}/api/documents/search
Content-Type: application/json

{
  "collection_name": "tech_docs",
  "query": "memory safety in programming languages",
  "top_k": 5,
  "search_mode": "hybrid_full_text",
  "fusion_mode": "rrf"
}

### Delete Document Collection
DELETE {{baseUrl}}/api/documents/collections/tech_docs

###############################################################################
# ORCHESTRATION & WORKFLOWS
###############################################################################

### Execute Workflow - Sequential Steps
POST {{baseUrl}}/api/orchestration/workflow
Content-Type: application/json

{
  "workflow_type": "sequential",
  "steps": [
    {
      "id": "step1",
      "task": "Read the README.md file",
      "tools": ["fs"]
    },
    {
      "id": "step2",
      "task": "Summarize the content from step1 in 2 sentences",
      "dependencies": ["step1"]
    }
  ],
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Execute Workflow - Parallel Steps
POST {{baseUrl}}/api/orchestration/workflow
Content-Type: application/json

{
  "workflow_type": "parallel",
  "steps": [
    {
      "id": "calc1",
      "task": "Calculate 123 * 456",
      "tools": ["calculator"]
    },
    {
      "id": "calc2",
      "task": "Calculate 789 + 321",
      "tools": ["calculator"]
    },
    {
      "id": "summary",
      "task": "Combine the results from calc1 and calc2",
      "dependencies": ["calc1", "calc2"]
    }
  ],
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Get Workflow Status
GET {{baseUrl}}/api/orchestration/workflow/workflow-123

### Pause Workflow Execution
POST {{baseUrl}}/api/orchestration/workflow/workflow-123/pause

### Resume Workflow Execution
POST {{baseUrl}}/api/orchestration/workflow/workflow-123/resume

### Multi-Agent Orchestration
POST {{baseUrl}}/api/orchestration/multi-agent
Content-Type: application/json

{
  "agents": [
    {
      "id": "researcher",
      "role": "Research information about Rust programming language",
      "tools": ["perplexity_search"]
    },
    {
      "id": "analyst",
      "role": "Analyze the research findings and identify key points",
      "depends_on": ["researcher"]
    },
    {
      "id": "writer",
      "role": "Write a summary report based on the analysis",
      "depends_on": ["analyst"]
    }
  ],
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Agent Coordinator - Supervised Workflow
POST {{baseUrl}}/api/orchestration/coordinator
Content-Type: application/json

{
  "coordinator_role": "Project manager coordinating a research task",
  "worker_agents": [
    {
      "id": "data_collector",
      "specialization": "Collecting data from various sources",
      "tools": ["perplexity_search", "http"]
    },
    {
      "id": "data_analyzer",
      "specialization": "Analyzing collected data and finding patterns",
      "tools": ["execute_python", "calculator"]
    }
  ],
  "task": "Research the top 5 programming languages in 2024 and analyze their growth trends",
  "provider": "{{provider}}",
  "model": "{{model}}"
}
