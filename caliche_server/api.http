### Caliche API Examples
### Base URL - Update this if running on a different host/port
@baseUrl = http://localhost:3000
@provider = anthropic
@model = openai/gpt-oss-120b 

###############################################################################
# BASIC ENDPOINTS
###############################################################################

### Health Check
GET {{baseUrl}}/health

### List Available Tools
GET {{baseUrl}}/api/tools

### List Available Models for "{{provider}}"
GET {{baseUrl}}/api/models?provider={{provider}}

###############################################################################
# CHAT ENDPOINTS
###############################################################################

### Basic Chat
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "What is 2 + 2?",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Chat with Specific Tools
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Calculate 123 * 456",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["calculator"]
}

### Chat with Multiple Tools
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Read the README.md file and echo it back",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["fs"]
}

### Chat with File Reading
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "What's in the README.md file?",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Chat with Directory Listing
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "List the files in the current directory",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Chat with URL Fetching
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Fetch the content from https://example.com and summarize it",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

### Advanced Calculator Operations
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Calculate 2 to the power of 10, and then find the square root of 144",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["calculator"]
}

### Complex Multi-Step Query
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Read the README file, then fetch https://example.com, and tell me what both contain",
  "provider": "{{provider}}",
  "model": "{{model}}"
}

