###############################################################################
# RAG (RETRIEVAL AUGMENTED GENERATION)
###############################################################################
#
# The RAG tool provides advanced embedding and retrieval capabilities.
# Note: Requires OPENAI_API_KEY or BEDROCK_EMBEDDINGS_ENABLED for embeddings.
#
# OPERATIONS:
# - 'index'          - Index a single document with doc_id
# - 'bulk_index'     - Efficiently index multiple documents at once
# - 'query'          - Basic semantic search
# - 'advanced_query' - Search with diversity reranking and filtering
# - 'stats'          - View indexed document statistics
# - 'clear'          - Remove all indexed documents
#
###############################################################################

### Index a Document
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool to index this document with doc_id 'rust_intro': Rust is a systems programming language that focuses on safety, speed, and concurrency. It achieves memory safety without using garbage collection.",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

### Query Indexed Documents
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool to query: 'What language is best for memory safety?'. Then summarize the findings.",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

### Bulk Index Multiple Documents
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool with operation 'bulk_index' to index these documents: [{'doc_id': 'rust_guide', 'content': 'Rust provides memory safety without garbage collection through its ownership system.'}, {'doc_id': 'python_guide', 'content': 'Python is dynamically typed and uses garbage collection for memory management.'}]",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

### Advanced Query with Diversity Reranking
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool with operation 'advanced_query' to query 'memory management' with use_diversity=true and top_k=5. This will avoid returning too many similar chunks.",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

### Get RAG Statistics
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool to show statistics about the indexed documents",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

### Clear RAG Cache
POST {{baseUrl}}/api/chat
Content-Type: application/json

{
  "message": "Use the rag tool to clear all indexed documents",
  "provider": "{{provider}}",
  "model": "{{model}}",
  "tools": ["semantic_search"]
}

